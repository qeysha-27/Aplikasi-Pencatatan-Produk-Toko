<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label styleClass="title" text="Form Tambah Produk Toko" />
            <Button onAction="#bukaDaftar" text="Lihat Daftar Produk" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label styleClass="subtitle" text="Tambah produk baru" />
                        <Label text="Nama produk" />
                        <TextField fx:id="namaField" promptText="Contoh: Roti Bakar Cokelat" />
                        <Label text="Kategori produk" />
                        <ComboBox fx:id="kategoriBox" maxWidth="Infinity" />
                        <Label styleClass="muted" text="Pilih kategori: Makanan atau Minuman" wrapText="true" />
                        <Label text="Harga produk (Rp)" />
                        <TextField fx:id="hargaField" promptText="Contoh: 15000" />
                        <Label text="Gambar produk (opsional)" />
                        <ImageView fx:id="gambarView" fitHeight="160" fitWidth="280" preserveRatio="true" />
                        <Button onAction="#pilihGambar" text="Pilih Gambar Produk" />
                        <Label styleClass="muted" text="PNG/JPEG, maksimal 5 MB. Gambar akan tampil di Tabel Daftar Produk dan Detail Produk." wrapText="true" />
                        <Button maxWidth="Infinity" onAction="#simpan" styleClass="button-primary" text="Simpan dan Lihat Detail" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
